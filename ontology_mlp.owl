<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/mlp-ontology#"
     xml:base="http://www.semanticweb.org/mlp-ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/mlp-ontology">
        <rdfs:comment xml:lang="ru">Онтология предметной области "My Little Pony: Friendship is Magic".
        Создана для Лабораторной работы 1 (Часть 2) дисциплины "Системы искусственного интеллекта".
        Описывает персонажей, типы существ, Стихии Гармонии, черты характера и отношения.</rdfs:comment>
        <rdfs:label xml:lang="ru">Онтология My Little Pony</rdfs:label>
    </owl:Ontology>

    <!-- OBJECT PROPERTIES (свойства-отношения между объектами) -->

    <!-- is_a: связывает персонажа с его видом/типом существа -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mlp-ontology#is_a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mlp-ontology#CreatureType"/>
        <rdfs:comment xml:lang="ru">Функциональное свойство: каждый персонаж имеет ровно один тип существа.</rdfs:comment>
        <rdfs:label xml:lang="ru">является видом</rdfs:label>
    </owl:ObjectProperty>

    <!-- bears_element: носитель Стихии Гармонии -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mlp-ontology#bears_element">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mlp-ontology#Element"/>
        <rdfs:comment xml:lang="ru">Связывает персонажа с его Стихией Гармонии (у большинства персонажей этого свойства нет).</rdfs:comment>
        <rdfs:label xml:lang="ru">несёт стихию</rdfs:label>
    </owl:ObjectProperty>

    <!-- lives_in: место проживания -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mlp-ontology#lives_in">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mlp-ontology#Location"/>
        <rdfs:label xml:lang="ru">живёт в</rdfs:label>
    </owl:ObjectProperty>

    <!-- DATA PROPERTIES -->
 
    <!-- has_trait: черта характера персонажа (строка) -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mlp-ontology#has_trait">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="ru">Черта характера персонажа. Может быть несколько.</rdfs:comment>
        <rdfs:label xml:lang="ru">обладает чертой</rdfs:label>
    </owl:DatatypeProperty>

    <!-- loves_activity: любимое занятие -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mlp-ontology#loves_activity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="ru">любит занятие</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Корневой класс: Pony все персонажи вселенной MLP -->
    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#Pony">
        <rdfs:subClassOf>
            <!-- Каждый персонаж обязан иметь хотя бы один тип существа -->
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/mlp-ontology#is_a"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="ru">Персонаж</rdfs:label>
    </owl:Class>

    <!-- Подкласс: MainSixPony персонажи, несущие Стихию Гармонии (вычисляемый класс) -->
    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#MainSixPony">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/mlp-ontology#Pony"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/mlp-ontology#bears_element"/>
                        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <rdfs:label xml:lang="ru">Носитель Стихии Гармонии (Главная Шестёрка)</rdfs:label>
        <rdfs:comment xml:lang="ru">Вычисляемый класс. Ризонер автоматически относит сюда персонажей с заполненным bears_element.</rdfs:comment>
    </owl:Class>

    <!-- Подкласс: RoyalPony аликорны с королевским статусом -->
    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#RoyalPony">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <rdfs:label xml:lang="ru">Королевский персонаж (Аликорн)</rdfs:label>
    </owl:Class>

    <!-- Класс: CreatureType виды существ -->
    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#CreatureType">
        <rdfs:label xml:lang="ru">Вид существа</rdfs:label>
    </owl:Class>

    <!-- Подклассы CreatureType -->
    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#Unicorn">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mlp-ontology#CreatureType"/>
        <rdfs:label xml:lang="ru">Единорог</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#Pegasus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mlp-ontology#CreatureType"/>
        <rdfs:label xml:lang="ru">Пегас</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#EarthPony">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mlp-ontology#CreatureType"/>
        <rdfs:label xml:lang="ru">Земная пони</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#Alicorn">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mlp-ontology#CreatureType"/>
        <rdfs:label xml:lang="ru">Аликорн</rdfs:label>
    </owl:Class>

    <!-- Дизъюнктность между подвидами (они не могут пересекаться) -->
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/mlp-ontology#Unicorn"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/mlp-ontology#Pegasus"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/mlp-ontology#EarthPony"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/mlp-ontology#Alicorn"/>
        </owl:members>
    </rdf:Description>

    <!-- Класс: Element Стихии Гармонии -->
    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#Element">
        <rdfs:label xml:lang="ru">Стихия Гармонии</rdfs:label>
    </owl:Class>

    <!-- Класс: Location локации Эквестрии -->
    <owl:Class rdf:about="http://www.semanticweb.org/mlp-ontology#Location">
        <rdfs:label xml:lang="ru">Локация в Эквестрии</rdfs:label>
    </owl:Class>

    <!-- ИНДИВИДЫ (экземпляры классов) -->

    <!-- Стихии Гармонии -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#ElementMagic">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Element"/>
        <rdfs:label xml:lang="ru">Стихия Магии</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#ElementLoyalty">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Element"/>
        <rdfs:label xml:lang="ru">Стихия Верности</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#ElementLaughter">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Element"/>
        <rdfs:label xml:lang="ru">Стихия Смеха</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#ElementGenerosity">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Element"/>
        <rdfs:label xml:lang="ru">Стихия Щедрости</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#ElementHonesty">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Element"/>
        <rdfs:label xml:lang="ru">Стихия Честности</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#ElementKindness">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Element"/>
        <rdfs:label xml:lang="ru">Стихия Доброты</rdfs:label>
    </owl:NamedIndividual>

    <!-- Виды существ -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#TypeAlicorn">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Alicorn"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#TypePegasus">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Pegasus"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#TypeUnicorn">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Unicorn"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#TypeEarthPony">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#EarthPony"/>
    </owl:NamedIndividual>

    <!-- Локации -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#Ponyville">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Location"/>
        <rdfs:label xml:lang="ru">Понивилль</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#Canterlot">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Location"/>
        <rdfs:label xml:lang="ru">Кантерлот</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#SweetAppleAcres">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Location"/>
        <rdfs:label xml:lang="ru">Сладкое Яблочное Ранчо</rdfs:label>
    </owl:NamedIndividual>

    <!-- Персонажи -->

    <!-- Twilight Sparkle -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#TwilightSparkle">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#RoyalPony"/>
        <is_a rdf:resource="http://www.semanticweb.org/mlp-ontology#TypeAlicorn"/>
        <bears_element rdf:resource="http://www.semanticweb.org/mlp-ontology#ElementMagic"/>
        <lives_in rdf:resource="http://www.semanticweb.org/mlp-ontology#Ponyville"/>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">studious</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organized</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">introverted</has_trait>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reading</loves_activity>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">magic_study</loves_activity>
        <rdfs:label xml:lang="ru">Искорка (Twilight Sparkle)</rdfs:label>
    </owl:NamedIndividual>

    <!-- Rainbow Dash -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#RainbowDash">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <is_a rdf:resource="http://www.semanticweb.org/mlp-ontology#TypePegasus"/>
        <bears_element rdf:resource="http://www.semanticweb.org/mlp-ontology#ElementLoyalty"/>
        <lives_in rdf:resource="http://www.semanticweb.org/mlp-ontology#Ponyville"/>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">brave</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">competitive</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loyal</has_trait>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flying</loves_activity>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sports</loves_activity>
        <rdfs:label xml:lang="ru">Радуга Дэш (Rainbow Dash)</rdfs:label>
    </owl:NamedIndividual>

    <!-- Pinkie Pie -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#PinkiePie">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <is_a rdf:resource="http://www.semanticweb.org/mlp-ontology#TypeEarthPony"/>
        <bears_element rdf:resource="http://www.semanticweb.org/mlp-ontology#ElementLaughter"/>
        <lives_in rdf:resource="http://www.semanticweb.org/mlp-ontology#Ponyville"/>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cheerful</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spontaneous</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social</has_trait>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parties</loves_activity>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">baking</loves_activity>
        <rdfs:label xml:lang="ru">Пинки Пай (Pinkie Pie)</rdfs:label>
    </owl:NamedIndividual>

    <!-- Rarity -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#Rarity">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <is_a rdf:resource="http://www.semanticweb.org/mlp-ontology#TypeUnicorn"/>
        <bears_element rdf:resource="http://www.semanticweb.org/mlp-ontology#ElementGenerosity"/>
        <lives_in rdf:resource="http://www.semanticweb.org/mlp-ontology#Ponyville"/>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">creative</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">elegant</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dramatic</has_trait>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fashion</loves_activity>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gems</loves_activity>
        <rdfs:label xml:lang="ru">Рарити (Rarity)</rdfs:label>
    </owl:NamedIndividual>

    <!-- Applejack -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#Applejack">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <is_a rdf:resource="http://www.semanticweb.org/mlp-ontology#TypeEarthPony"/>
        <bears_element rdf:resource="http://www.semanticweb.org/mlp-ontology#ElementHonesty"/>
        <lives_in rdf:resource="http://www.semanticweb.org/mlp-ontology#SweetAppleAcres"/>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hardworking</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">honest</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stubborn</has_trait>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">farming</loves_activity>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rodeo</loves_activity>
        <rdfs:label xml:lang="ru">Эпплджек (Applejack)</rdfs:label>
    </owl:NamedIndividual>

    <!-- Fluttershy -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#Fluttershy">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <is_a rdf:resource="http://www.semanticweb.org/mlp-ontology#TypePegasus"/>
        <bears_element rdf:resource="http://www.semanticweb.org/mlp-ontology#ElementKindness"/>
        <lives_in rdf:resource="http://www.semanticweb.org/mlp-ontology#Ponyville"/>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">shy</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">caring</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gentle</has_trait>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">animals</loves_activity>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nature</loves_activity>
        <rdfs:label xml:lang="ru">Флаттершай (Fluttershy)</rdfs:label>
    </owl:NamedIndividual>

    <!-- Princess Celestia -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#PrincessCelestia">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#RoyalPony"/>
        <is_a rdf:resource="http://www.semanticweb.org/mlp-ontology#TypeAlicorn"/>
        <lives_in rdf:resource="http://www.semanticweb.org/mlp-ontology#Canterlot"/>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wise</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">caring</has_trait>
        <rdfs:label xml:lang="ru">Принцесса Селестия</rdfs:label>
    </owl:NamedIndividual>

    <!-- Starlight Glimmer -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mlp-ontology#StarlightGlimmer">
        <rdf:type rdf:resource="http://www.semanticweb.org/mlp-ontology#Pony"/>
        <is_a rdf:resource="http://www.semanticweb.org/mlp-ontology#TypeUnicorn"/>
        <lives_in rdf:resource="http://www.semanticweb.org/mlp-ontology#Ponyville"/>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">determined</has_trait>
        <has_trait rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reformed</has_trait>
        <loves_activity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">magic_study</loves_activity>
        <rdfs:label xml:lang="ru">Старлайт Глиммер (Starlight Glimmer)</rdfs:label>
    </owl:NamedIndividual>

</rdf:RDF>

